# Adres strony z wynikami wyszukiwania neurologa (skopiuj z paska przeglądarki po `python bot.py setup`)
SEARCH_URL=https://mol.medicover.pl/

# Tekst widoczny na stronie, gdy nie ma terminów (sprawdź dokładne brzmienie na stronie)
NO_SLOTS_TEXT=Brak wolnych terminów

# Opcjonalnie: selektor CSS przycisku "Szukaj" (jeśli samo odświeżenie URL nie odpala wyszukiwania)
SEARCH_BUTTON=
# Opcjonalnie: selektor CSS pojedynczego terminu (dokładniejsze wykrywanie)
SLOT_SELECTOR=

# Odstęp między sprawdzeniami (losowo, w sekundach) - nie schodź za nisko, żeby nie obciążać serwisu
INTERVAL_MIN=45
INTERVAL_MAX=90
HEADLESS=0

# Mail (opcjonalnie). Dla Gmaila użyj "hasła aplikacji", nie zwykłego hasła.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=

# Dane do automatycznego logowania po wygaśnięciu sesji (nie commituj .env!)
MEDICOVER_USER=
MEDICOVER_PASSWORD=
